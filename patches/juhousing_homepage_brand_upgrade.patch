 harness/regression/test_site_content.py |  26 +++
 html/index.html                         | 212 +++++++++++++++++++++---
 html/js/site-render.js                  |  72 +++++++-
 html/site-content.json                  |  85 ++++++++--
 5 files changed, 357 insertions(+), 40 deletions(-)

